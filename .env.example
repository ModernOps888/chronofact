# ChronoFact Configuration Template
# Copy to .env and configure as needed.
# ChronoFact operates fully autonomously locally out of the box with zero external keys required.

# Server Configuration
CHRONOFACT_PORT=3030
CHRONOFACT_HOST=127.0.0.1
CHRONOFACT_DB_PATH=chronofact_memory.db

# Optional: External Search Provider API Keys (if not using local browser/mcp scraper)
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=

# Optional: Remote LLM Verification API Keys (if running standalone daemon without IDE proxy)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
